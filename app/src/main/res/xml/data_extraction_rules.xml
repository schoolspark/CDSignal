<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref"/>

        <include domain="database"/>

        <exclude domain="cache"/>
        <exclude domain="external"/>
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref"/>
        <include domain="database"/>
        <exclude domain="cache"/>
        <exclude domain="external"/>
    </device-transfer>
</data-extraction-rules>